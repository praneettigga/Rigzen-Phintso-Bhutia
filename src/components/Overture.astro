---
import { getImage } from 'astro:assets';
import poster from '../assets/brand/thank-you-poster.jpg';
import { site } from '../data/site';
const img = await getImage({ src: poster, width: 700, format: 'webp' });
---

<!--
  Opening sequence, after edisonfangworkshop.com's "overture", rebuilt around Rigzen's own drawings:
  a 000→100 counter on a single coral line → the Tibetan title → a one-point perspective grid
  opening from the vanishing point → the lines folding into one poster frame → the page.
  Plays once per session on the home page; skipped under reduced motion.
-->
<div id="overture" aria-hidden="true">
  <svg id="ov-svg" xmlns="http://www.w3.org/2000/svg">
    <g id="ov-grid" stroke="#f3d9db" stroke-width="0.7" fill="none"></g>
    <rect id="ov-frame" fill="none" stroke="#ea9396" stroke-width="1" opacity="0"></rect>
    <image id="ov-poster" href={img.src} preserveAspectRatio="xMidYMid slice" opacity="0"></image>
    <line id="ov-spine" stroke="#ea9396" stroke-width="0.8" opacity="0.18"></line>
    <line id="ov-light" stroke="#ea9396" stroke-width="1.6" stroke-linecap="round"></line>
    <text id="ov-count" fill="#f3d9db" text-anchor="middle">000</text>
    <text id="ov-tib" fill="#fbeff0" text-anchor="middle" opacity="0">{site.coverTibetan}</text>
    <text id="ov-cap" fill="#f3d9db" text-anchor="middle" opacity="0">RIGZEN PHINTSO BHUTIA · SELECTED WORKS 2023 — 2026</text>
  </svg>
  <button id="ov-skip" type="button" tabindex="0">Enter</button>
</div>

<style>
  #overture {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: #22344a;
    color: #fbeff0;
    user-select: none;
    -webkit-user-select: none;
  }
  :global(html.play-overture) #overture { display: block; }
  :global(html.play-overture) { overflow: hidden; }
  #ov-svg { width: 100%; height: 100%; font-family: var(--mono); }
  #ov-count { font-size: 13px; letter-spacing: 0.08em; font-variant-numeric: tabular-nums; font-weight: 300; }
  #ov-tib { font-family: var(--tibetan); font-size: clamp(28px, 5vw, 56px); }
  #ov-cap { font-size: 10.5px; letter-spacing: 0.22em; font-weight: 300; }
  #ov-skip {
    position: absolute;
    right: max(22px, env(safe-area-inset-right));
    bottom: max(22px, env(safe-area-inset-bottom));
    min-width: 44px;
    min-height: 44px;
    padding: 10px 4px;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: #f3d9db;
    opacity: 0.8;
  }
  #ov-skip:hover { opacity: 1; }
</style>

<script>
  import { holdReveals } from '../scripts/motion';

  const END = 6100;
  const clamp = (x: number) => Math.max(0, Math.min(1, x));
  const smooth = (x: number) => {
    x = clamp(x);
    return x * x * (3 - 2 * x);
  };
  const mix = (a: number, b: number, t: number) => a + (b - a) * t;
  const set = (el: Element, attrs: Record<string, string | number>) => {
    for (const k in attrs) el.setAttribute(k, String(attrs[k]));
  };

  function perspective(w: number, h: number) {
    const cx = w / 2;
    const cy = h / 2;
    const segs: number[][] = [];
    // rings: nested rectangles receding to the vanishing point
    for (let k = 1; k <= 7; k++) {
      const s = Math.pow(k / 7, 1.9) * 1.04;
      const l = cx - (w / 2) * s, r = cx + (w / 2) * s, t = cy - (h / 2) * s, b = cy + (h / 2) * s;
      segs.push([l, t, r, t], [r, t, r, b], [r, b, l, b], [l, b, l, t]);
    }
    // rays from the vanishing point to the frame edge
    const n = 8;
    for (let i = 0; i <= n; i++) {
      const fx = (w * i) / n, fy = (h * i) / n;
      segs.push([cx, cy, fx, 0], [cx, cy, fx, h], [cx, cy, 0, fy], [cx, cy, w, fy]);
    }
    return segs;
  }

  function play() {
    const root = document.getElementById('overture');
    const svg = document.getElementById('ov-svg');
    if (!root || !svg) return finish();
    const $ = (id: string) => document.getElementById(id)!;
    const grid = $('ov-grid');
    let w = 0, h = 0, segs: number[][] = [], lines: SVGLineElement[] = [];
    let card = { x: 0, y: 0, w: 0, h: 0 };

    const layout = () => {
      w = innerWidth;
      h = innerHeight;
      svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
      segs = perspective(w, h);
      while (lines.length < segs.length) {
        const l = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        grid.append(l);
        lines.push(l);
      }
      const ch = Math.min(h * 0.52, w * 0.9 * 1.6);
      const cw = ch * 0.62;
      card = { x: (w - cw) / 2, y: (h - ch) / 2 - h * 0.03, w: cw, h: ch };
    };
    layout();
    addEventListener('resize', layout);

    let start = 0;
    let raf = 0;
    let done = false;

    const render = (ms: number) => {
      const p = clamp(ms / 1600);
      const exit = smooth((ms - 1700) / 450);
      const top = h * 0.36;
      const tip = h * (0.36 + 0.26 * p);
      set($('ov-light'), { x1: w / 2, x2: w / 2, y1: tip - 18, y2: tip, opacity: 1 - exit });
      set($('ov-spine'), { x1: w / 2, x2: w / 2, y1: mix(top, tip, exit), y2: tip, opacity: 0.18 * (1 - exit) });
      const count = $('ov-count');
      count.textContent = String(Math.round(p * 100)).padStart(3, '0');
      set(count, { x: w / 2, y: tip + 24, opacity: 1 - exit });

      const tibIn = smooth((ms - 1800) / 400), tibOut = smooth((ms - 2550) / 350);
      set($('ov-tib'), { x: w / 2, y: h / 2 + 14 - 10 * tibIn, opacity: tibIn * (1 - tibOut) });

      const flatten = smooth((ms - 3900) / 800);
      const edges = [
        [card.x, card.y, card.x + card.w, card.y],
        [card.x + card.w, card.y, card.x + card.w, card.y + card.h],
        [card.x + card.w, card.y + card.h, card.x, card.y + card.h],
        [card.x, card.y + card.h, card.x, card.y],
      ];
      segs.forEach((s, i) => {
        const delay = i < 28 ? Math.floor(i / 4) * 40 : 120 + (i % 9) * 18;
        const spread = smooth((ms - 2700 - delay) / 800);
        const d = edges[i % 4];
        const c = s.map((v, j) => {
          const centre = j % 2 ? h / 2 : w / 2;
          return mix(mix(centre, v, spread), d[j], flatten);
        });
        set(lines[i], {
          x1: c[0], y1: c[1], x2: c[2], y2: c[3],
          opacity: spread * mix(0.55, i < 4 ? 0.9 : 0, flatten),
        });
      });

      const frameIn = smooth((ms - 4500) / 300);
      set($('ov-frame'), { x: card.x - 9, y: card.y - 9, width: card.w + 18, height: card.h + 18, opacity: frameIn, 'stroke-dasharray': '5 4' });
      const posterIn = smooth((ms - 4500) / 600);
      set($('ov-poster'), { x: card.x, y: card.y, width: card.w, height: card.h, opacity: posterIn });
      set($('ov-cap'), { x: w / 2, y: card.y + card.h + 44, opacity: smooth((ms - 4800) / 400) });

      const out = smooth((ms - 5500) / 600);
      root.style.opacity = String(1 - out);
      if (out > 0.3) holdReveals(false);
    };

    const tick = (t: number) => {
      if (!start) start = t;
      const ms = t - start;
      render(ms);
      if (ms < END && !done) raf = requestAnimationFrame(tick);
      else finish();
    };

    function finish() {
      if (done) return;
      done = true;
      cancelAnimationFrame(raf);
      removeEventListener('resize', layout);
      try { sessionStorage.setItem('overture-seen', '1'); } catch {}
      document.documentElement.classList.remove('play-overture');
      if (root) root.style.opacity = '';
      holdReveals(false);
      document.dispatchEvent(new CustomEvent('overture:done'));
    }

    $('ov-skip').addEventListener('click', finish, { once: true });
    addEventListener('keydown', function onKey(e) {
      if (e.key === 'Escape' || e.key === 'Enter') { finish(); removeEventListener('keydown', onKey); }
    });
    raf = requestAnimationFrame(tick);
  }

  function finishImmediately() {
    document.documentElement.classList.remove('play-overture');
    holdReveals(false);
  }

  document.addEventListener('astro:page-load', () => {
    if (!document.documentElement.classList.contains('play-overture')) return;
    if (!document.getElementById('overture')) return finishImmediately();
    holdReveals(true);
    play();
  });
</script>
