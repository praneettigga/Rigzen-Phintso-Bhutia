---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  caption: string;
  n: number;
  total: number;
  sizes?: string;
  class?: string;
  eager?: boolean;
  delay?: number;
}
const { src, caption, n, total, sizes = '(max-width: 900px) 100vw, 80vw', class: cls, eager = false, delay = 0 } = Astro.props;
const full = await getImage({ src, width: Math.min(src.width, 2800), format: 'webp', quality: 86 });
const pad = (x: number) => String(x).padStart(2, '0');
const widths = [480, 800, 1200, 1600, 2200].filter((w) => w <= src.width);
if (!widths.length) widths.push(src.width);
---
<figure class:list={['fig', cls]}>
  <button type="button" class="zoom" data-zoom={full.src} data-caption={caption} aria-label={`Enlarge: ${caption}`}>
    <span class="media" data-wipe style={`--delay:${delay}ms`}>
      <Image src={src} alt={caption} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
    </span>
  </button>
  <figcaption><span class="boxed">{pad(n)} / {pad(total)}</span> <span>{caption}</span></figcaption>
</figure>

<style>
  .fig { display: grid; gap: 0.7rem; min-width: 0; }
  .zoom { display: block; width: 100%; cursor: zoom-in; text-align: left; }
  .media { display: block; overflow: hidden; background: var(--blush-50); }
  .media :global(img) { width: 100%; height: auto; }
  figcaption { font-size: var(--step--1); color: var(--ink-soft); display: flex; gap: 0.7rem; align-items: baseline; line-height: 1.5; }
  figcaption .boxed { flex: none; font-variant-numeric: tabular-nums; }
</style>
