---
import Mark from './Mark.astro';
const path = Astro.url.pathname;
---
<header class="site-header" data-header>
  <div class="bar wrap">
    <a href="/" class="brand" aria-label="Rigzen Phintso Bhutia — home">
      <Mark />
      <span class="wordmark"><span>Rigzen Phintso</span><span>Bhutia</span></span>
    </a>
    <p class="crumb label" aria-hidden="true">
      {path.startsWith('/work') ? 'Selected works / 2023 — 2026' : path.startsWith('/about') ? 'The student / Sikkim → Manipal' : path.startsWith('/contact') ? 'Write a note / 04' : 'Architecture / Portfolio'}
    </p>
    <button class="menu-trigger" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-trigger>
      <span class="menu-label"><span>Menu</span><span>Close</span></span>
      <span class="menu-pill" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-h);
    transition: transform 0.6s var(--ease), background-color 0.4s, border-color 0.4s;
    border-bottom: 1px solid transparent;
  }
  .site-header:global(.is-scrolled) {
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-color: var(--line);
  }
  .site-header:global(.is-hidden) { transform: translateY(-100%); }
  :global(html.menu-open) .site-header { transform: none; background: transparent; border-color: transparent; backdrop-filter: none; }
  .bar { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.85rem; color: var(--ink); }
  .wordmark { display: flex; flex-direction: column; font-size: 0.66rem; line-height: 1.35; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); }
  .crumb { position: absolute; left: 50%; transform: translateX(-50%); }
  @media (max-width: 760px) { .crumb { display: none; } }
  .menu-trigger { display: inline-flex; align-items: center; gap: 0.75rem; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .menu-label { display: grid; height: 1.3em; overflow: hidden; }
  .menu-label span { grid-area: 1 / 1; transition: transform 0.55s var(--ease); line-height: 1.3; }
  .menu-label span:last-child { transform: translateY(110%); }
  :global(html.menu-open) .menu-label span:first-child { transform: translateY(-110%); }
  :global(html.menu-open) .menu-label span:last-child { transform: none; }
  .menu-pill { width: 34px; height: 34px; border: 1px solid var(--ink); border-radius: 50%; display: grid; place-content: center; gap: 4px; transition: background-color 0.3s, border-color 0.3s; }
  .menu-pill i { display: block; width: 12px; height: 1.2px; background: currentColor; transition: transform 0.5s var(--ease); }
  .menu-trigger:hover .menu-pill { background: var(--blush-100); border-color: var(--rose); }
  :global(html.menu-open) .menu-pill i:first-child { transform: translateY(2.6px) rotate(45deg); }
  :global(html.menu-open) .menu-pill i:last-child { transform: translateY(-2.6px) rotate(-45deg); }
</style>
