---
// Grace-style section starter: a thin bordered bar, big title left, small subtitle right.
interface Props { title: string; sub?: string; num?: string; id?: string }
const { title, sub, num, id } = Astro.props;
---
<div class="section-bar wrap" id={id} data-reveal>
  <div class="inner">
    <h2>{num && <span class="num">{num}</span>}{title}<span class="dot">.</span></h2>
    {sub && <p class="label">{sub}</p>}
  </div>
</div>
<style>
  .inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border: 1px solid var(--rose); padding: 0.4rem clamp(1rem, 3vw, 2.5rem); }
  h2 { font-size: var(--step-3); font-weight: 300; letter-spacing: -0.03em; color: var(--rose); line-height: 1.25; }
  .num { font-size: 0.32em; color: var(--ink); vertical-align: 1.6em; margin-right: 0.6em; letter-spacing: 0.08em; }
  .num::before { content: '✱'; margin-right: 0.15em; }
  .dot { color: var(--rose); }
</style>
