---
import { Image } from 'astro:assets';
import scribble from '../assets/brand/portfolio-scribble.png';
import { site } from '../data/site';
---
<section class="cover" aria-label="Selected works 2023 to 2026">
  <p class="tags label" data-reveal>Resort · Office · Housing · Working drawing · Illustration</p>
  <div class="sheet">
    <p class="arch rose" data-split>Architecture</p>
    <div class="scribble" data-write style="--delay:200ms">
      <Image src={scribble} alt="portfolio" widths={[700, 1200, 1800, 2400]} sizes="(max-width: 900px) 92vw, 1100px" />
    </div>
    <p class="tib tibetan" lang="bo" data-reveal style="--delay:600ms">{site.coverTibetan}</p>
    <p class="sel rose" data-split style="--base:700ms">Selected Works</p>
    <p class="yr yl rose" data-reveal>{site.years[0]}</p>
    <p class="yr yr2 rose" data-reveal>{site.years[1]}</p>
  </div>
</section>

<style>
  .cover { padding: clamp(4rem, 10vw, 9rem) var(--gutter) clamp(3rem, 6vw, 5rem); max-width: var(--maxw); margin-inline: auto; }
  .tags { text-align: center; margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  .sheet { position: relative; display: grid; justify-items: center; gap: clamp(0.6rem, 2vw, 1.6rem); padding-bottom: 1rem; }
  .arch, .sel { font-size: var(--step-2); letter-spacing: 0.02em; font-weight: 340; }
  .scribble { width: min(1100px, 92vw); }
  .scribble :global(img) { width: 100%; }
  .tib { font-size: var(--step-2); color: var(--ink); }
  .yr { position: absolute; bottom: 0; font-size: var(--step-2); font-weight: 300; }
  .yl { left: 0; }
  .yr2 { right: 0; }
  @media (max-width: 640px) { .yr { position: static; } .sheet { grid-template-columns: 1fr 1fr; } .sheet > :not(.yr) { grid-column: 1 / -1; } .yl { justify-self: start; } .yr2 { justify-self: end; } }
</style>
