<dialog class="lightbox" data-lightbox aria-label="Enlarged drawing">
  <form method="dialog" class="top">
    <p class="cap label" data-lb-caption></p>
    <button class="close label" aria-label="Close">Close ✕</button>
  </form>
  <div class="scroller" data-lb-scroller><img alt="" data-lb-img /></div>
  <p class="tip label">Scroll / pinch to look closer · Esc to close</p>
</dialog>

<style>
  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(255, 255, 255, 0.97); color: var(--ink); }
  .lightbox[open] { display: grid; grid-template-rows: auto 1fr auto; animation: lbin 0.45s var(--ease); }
  .lightbox::backdrop { background: rgba(54, 81, 111, 0.2); }
  @keyframes lbin { from { opacity: 0; transform: scale(0.98); } }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem var(--gutter); border-bottom: 1px solid var(--line); }
  .close:hover { color: var(--rose); }
  .scroller { overflow: auto; display: grid; place-items: center; padding: 2vh var(--gutter); overscroll-behavior: contain; }
  .scroller img { max-width: 100%; max-height: 82dvh; width: auto; height: auto; cursor: zoom-in; }
  .scroller.zoomed { place-items: start; }
  .scroller.zoomed img { max-width: none; max-height: none; cursor: zoom-out; }
  .tip { text-align: center; padding: 0.6rem; text-transform: none; }
</style>

<script>
  import { getLenis } from '../scripts/motion';

  function initLightbox() {
    const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    if (!dlg) return;
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lb-caption]')!;
    const scroller = dlg.querySelector<HTMLElement>('[data-lb-scroller]')!;
    document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((btn) => {
      btn.addEventListener('click', () => {
        img.src = btn.dataset.zoom!;
        img.alt = btn.dataset.caption ?? '';
        cap.textContent = btn.dataset.caption ?? '';
        scroller.classList.remove('zoomed');
        dlg.showModal();
        getLenis()?.stop();
      });
    });
    img.addEventListener('click', (e) => {
      const zoomed = scroller.classList.toggle('zoomed');
      if (zoomed) {
        const r = img.getBoundingClientRect();
        const fx = (e.clientX - r.left) / r.width, fy = (e.clientY - r.top) / r.height;
        requestAnimationFrame(() => {
          scroller.scrollLeft = img.scrollWidth * fx - scroller.clientWidth / 2;
          scroller.scrollTop = img.scrollHeight * fy - scroller.clientHeight / 2;
        });
      }
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => getLenis()?.start());
  }
  document.addEventListener('astro:page-load', initLightbox);
</script>
