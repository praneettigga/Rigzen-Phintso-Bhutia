---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import poster from '../assets/brand/thank-you-poster.jpg';
import thanks from '../assets/brand/thank-you-scribble.png';
import { site } from '../data/site';
---
<Base title="Contact" description={`Write to Rigzen Phintso Bhutia — ${site.email}. Open to architecture internships and collaborations.`}>
  <section class="contact wrap">
    <p class="label top" data-reveal>Contact / 04 — no finished brief required</p>
    <p class="tib tibetan" lang="bo" data-reveal style="--delay:100ms">{site.thanksTibetan}</p>
    <div class="card" data-reveal style="--delay:200ms">
      <Image src={poster} alt="A drawing of intersecting coral and navy planes" widths={[300, 480, 640]} sizes="260px" />
    </div>
    <div class="ty" data-write style="--delay:700ms"><Image src={thanks} alt="Thank you!" widths={[400, 800]} sizes="280px" /></div>
    <h1 class="sr-only">Contact Rigzen Phintso Bhutia</h1>
    <p class="note" data-reveal>Open to architecture internships, collaborations and conversations about space. Let’s start with a note.</p>
    <div class="mail" data-reveal>
      <a href={`mailto:${site.email}?subject=Hello%20Rigzen`} class="addr">{site.email}</a>
      <button type="button" class="copy label" data-copy={site.email}>Copy</button>
    </div>
  </section>
</Base>

<style>
  .contact { padding-top: calc(var(--header-h) + 8vh); display: grid; justify-items: center; text-align: center; gap: 1.6rem; }
  .top { margin-bottom: 2rem; }
  .tib { font-size: var(--step-3); color: var(--ink); }
  .card { width: min(260px, 64vw); padding: 10px; border: 1px dashed var(--rose); }
  .card :global(img) { width: 100%; }
  .ty { width: min(280px, 68vw); }
  .note { max-width: 42ch; color: var(--ink-soft); margin-top: 1rem; }
  .mail { display: flex; align-items: baseline; gap: 1.2rem; flex-wrap: wrap; justify-content: center; }
  .addr { font-size: var(--step-3); font-weight: 300; letter-spacing: -0.03em; border-bottom: 1px solid var(--rose); transition: color 0.3s; word-break: break-all; }
  .addr:hover { color: var(--rose); }
  .copy { border: 1px solid var(--ink); border-radius: 999px; padding: 0.35rem 0.9rem; transition: background 0.3s, color 0.3s; }
  .copy:hover { background: var(--ink); color: #fff; }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const b = document.querySelector<HTMLButtonElement>('[data-copy]');
    b?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = 'Copied ✱';
        setTimeout(() => (b.textContent = 'Copy'), 1800);
      } catch {}
    });
  });
</script>
