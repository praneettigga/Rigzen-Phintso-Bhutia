---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionBar from '../components/SectionBar.astro';
import SkillMeter from '../components/SkillMeter.astro';
import portrait from '../assets/brand/portrait.jpg';
import { site, statement, education, skills, languages, interests, events, achievements } from '../data/site';
---
<Base title="About" description="About Rigzen Phintso Bhutia — 4th-year architecture student from Sikkim with Tibetan roots, studying at Manipal School of Architecture & Planning.">
  <section class="a-hero wrap">
    <p class="label" data-reveal>01 / Profile</p>
    <h1 class="a-title" data-split>A little context<span class="rose">.</span><br />Never too much<span class="rose">.</span></h1>
  </section>

  <section class="profile wrap">
    <figure class="ph" data-reveal>
      <div class="frame"><Image src={portrait} alt={`Portrait of ${site.name}`} widths={[400, 640]} sizes="(max-width: 860px) 80vw, 360px" /></div>
      <figcaption>
        <span class="tibetan rose" lang="bo">{site.tibetanName}</span>
        <span class="nm">{site.name}</span>
        <span class="label">{site.role}</span>
      </figcaption>
    </figure>
    <div class="stmt">
      {statement.map((s, i) => <p class:list={[i === 0 ? 'lead' : 'body']} data-reveal style={`--delay:${i * 120}ms`}>{s}</p>)}
      <p class="body rose-ink" data-reveal>This portfolio is a showcase of my personal work throughout my university journey. I’m Rigzen, a 21-year-old architecture student, and I aim to express myself through the work curated here.</p>
    </div>
  </section>

  <SectionBar num="02" title="roots" sub="sikkim · bhutia · tibetan" />
  <section class="roots wrap">
    <p class="big" data-split style="--stagger:8ms">Rigzen is Bhutia — from Sikkim, in the eastern Himalaya, with Tibetan roots.</p>
    <p class="body" data-reveal>That is why each project in this portfolio carries a Tibetan name: <span class="tibetan rose" lang="bo">བསྟེན་པ</span> <em>bsten-pa</em> (to stay) for the resort, <span class="tibetan rose" lang="bo">ལས་ཁུངས</span> <em>la-khung</em> (office) for the office, and <span class="tibetan rose" lang="bo">སྡོད་ཁང་</span> <em>sdod-khang</em> (dwelling) for the housing. The cover reads <span class="tibetan rose" lang="bo">{site.coverTibetan}</span> — architecture, works.</p>
  </section>

  <SectionBar num="03" title="education" sub="2008 — present" />
  <section class="list wrap">
    <ol class="timeline">
      {education.map((e, i) => (
        <li data-reveal style={`--delay:${i * 90}ms`}><span class="yr">{e.years}</span><span class="pl">{e.place}</span><span class="wh label">{e.where}</span></li>
      ))}
    </ol>
  </section>

  <SectionBar num="04" title="software" sub="efficiency ✱ out of ten" />
  <section class="skills wrap">
    {skills.map((g) => (
      <div class="group" data-reveal>
        <h3>{g.group}</h3>
        {g.items.map((s) => <SkillMeter name={s.name} level={s.level} />)}
      </div>
    ))}
  </section>

  <SectionBar num="05" title="languages & interests" sub="five tongues / seven pastimes" />
  <section class="two wrap">
    <dl class="langs">
      {languages.map((l, i) => (<div data-reveal style={`--delay:${i * 70}ms`}><dt>{l.name}</dt><dd>{l.level}</dd></div>))}
    </dl>
    <ul class="interests" data-reveal>
      {interests.map((x) => <li>{x}</li>)}
    </ul>
  </section>

  <SectionBar num="06" title="events & achievements" sub="on and off the drawing board" />
  <section class="list wrap">
    <ol class="timeline">
      {[...events, ...achievements].map((e, i) => (
        <li data-reveal style={`--delay:${i * 70}ms`}><span class="yr">{e.year}</span><span class="pl">{e.what}</span></li>
      ))}
    </ol>
    <a href="/contact" class="arrow-link link-u cta" data-reveal>Write a note to Rigzen <svg viewBox="0 0 12 12" fill="none" stroke="currentColor"><path d="M2 10 10 2M4 2h6v6" /></svg></a>
  </section>
</Base>

<style>
  .a-hero { padding-top: calc(var(--header-h) + 10vh); padding-bottom: clamp(3rem, 7vw, 6rem); display: grid; gap: 1.5rem; }
  .a-title { font-size: var(--step-5); font-weight: 300; letter-spacing: -0.05em; line-height: 1; }
  .profile { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: clamp(2rem, 7vw, 7rem); align-items: start; padding-bottom: clamp(5rem, 10vw, 8rem); }
  .frame { border: 1.5px solid var(--rose); }
  .frame :global(img) { filter: grayscale(1); width: 100%; }
  figcaption { display: grid; gap: 0.2rem; margin-top: 1rem; }
  .nm { font-size: var(--step-1); font-weight: 450; }
  .stmt { display: grid; gap: 1.4rem; max-width: 60ch; }
  .lead { font-size: var(--step-2); line-height: 1.4; font-weight: 320; letter-spacing: -0.01em; }
  .body { color: var(--ink-soft); }
  .rose-ink { color: var(--rose-ink); }
  .roots, .list, .skills, .two { padding-top: clamp(2.5rem, 5vw, 4rem); padding-bottom: clamp(5rem, 10vw, 8rem); }
  .roots { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: end; }
  .big { font-size: var(--step-3); font-weight: 300; line-height: 1.2; letter-spacing: -0.03em; }
  .timeline { border-top: 1px solid var(--ink); }
  .timeline li { display: grid; grid-template-columns: 9rem 1fr auto; gap: 1rem; padding: 1rem 0; border-bottom: 1px dashed var(--dash); align-items: baseline; }
  .yr { color: var(--rose); font-size: var(--step--1); font-variant-numeric: tabular-nums; }
  .pl { font-size: var(--step-1); }
  .skills { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem clamp(2rem, 6vw, 6rem); }
  .group h3 { font-size: var(--step-0); font-weight: 480; margin-bottom: 0.5rem; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); }
  .langs div { display: grid; grid-template-columns: 7rem 1fr; padding: 0.7rem 0; border-bottom: 1px dashed var(--dash); }
  .langs dt { font-weight: 480; }
  .langs dd { color: var(--ink-soft); }
  .interests { display: flex; flex-wrap: wrap; gap: 0.6rem; align-content: start; }
  .interests li { border: 1px solid var(--rose); color: var(--rose-ink); padding: 0.35rem 0.85rem; border-radius: 999px; font-size: var(--step--1); transition: background 0.3s, color 0.3s; }
  .interests li:hover { background: var(--rose); color: #fff; }
  .cta { margin-top: 3rem; font-size: var(--step-1); }
  @media (max-width: 860px) {
    .profile, .roots, .skills, .two { grid-template-columns: 1fr; }
    .timeline li { grid-template-columns: 6.5rem 1fr; }
    .timeline .wh { grid-column: 2; }
  }
</style>
