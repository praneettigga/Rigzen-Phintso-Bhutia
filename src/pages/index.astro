---
import Base from '../layouts/Base.astro';
import Overture from '../components/Overture.astro';
import Hero from '../components/Hero.astro';
import CoverStatement from '../components/CoverStatement.astro';
import ContentsStrip from '../components/ContentsStrip.astro';
import SectionBar from '../components/SectionBar.astro';
import { statement } from '../data/site';
---
<Base>
  <Overture />
  <Hero />
  <CoverStatement />
  <ContentsStrip />
  <SectionBar title="about" sub="sikkim / tibetan roots / manipal" />
  <section class="about-teaser wrap">
    <p class="big" data-split style="--stagger:8ms">{statement[0]}</p>
    <div class="side" data-reveal>
      <p>{statement[1]}</p>
      <a href="/about" class="arrow-link link-u">More about Rigzen <svg viewBox="0 0 12 12" fill="none" stroke="currentColor"><path d="M2 10 10 2M4 2h6v6" /></svg></a>
    </div>
  </section>
</Base>

<style>
  .about-teaser { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem, 6vw, 6rem); padding-top: clamp(2.5rem, 6vw, 5rem); align-items: end; }
  .big { font-size: var(--step-2); line-height: 1.45; font-weight: 320; }
  .side { display: grid; gap: 1.5rem; color: var(--rose-ink); }
  .side a { color: var(--ink); justify-self: start; }
  @media (max-width: 860px) { .about-teaser { grid-template-columns: 1fr; } }
</style>
