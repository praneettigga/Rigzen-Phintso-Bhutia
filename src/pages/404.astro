---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" footer={false}>
  <section class="nf wrap">
    <p class="label">Sheet missing / 404</p>
    <h1 data-split>This drawing isn’t in the set<span class="rose">.</span></h1>
    <a href="/" class="arrow-link link-u">Return to the cover <svg viewBox="0 0 12 12" fill="none" stroke="currentColor"><path d="M2 10 10 2M4 2h6v6" /></svg></a>
  </section>
</Base>
<style>
  .nf { min-height: 100svh; display: grid; align-content: center; gap: 2rem; }
  h1 { font-size: var(--step-4); font-weight: 300; letter-spacing: -0.04em; line-height: 1.05; max-width: 16ch; }
</style>
